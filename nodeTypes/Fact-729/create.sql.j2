{# == Node Type Name           : Fact  == #}
{# == Node Type Description    : This node creates fact table or view with advanced deployment strategy  == #}
{#---------------------------------------------------------------------------------------------#}

{#- nsNodeVariables (object paths, materialization types, metaDataChanged) is created and initialized in the shared macros #}

{#- Desired/current materialization type, normalized ("Table " = "table").
    Empty string when the state is absent (first deploy has no currentState; delete has no desiredState). #}
{%- set desiredMatType = nsNodeVariables.desiredMatType %}
{%- set currentMatType = nsNodeVariables.currentMatType %}

{%- if desiredState %}

    {# Validate: the materialization type must be table or view #}
    {{ validate_materialization_type() }}

    {# Validate: the same tag key applied twice to the node is not allowed #}
    {{ tag_check_duplicates() }}

    {%- if desiredMatType == 'view' %}

        {# Drop the current object if it was another type, or the view was renamed/moved #}
        {{ object_drop_sql() }}

        {# Did the view definition change? Render it for both states and compare #}
        {%- set viewDefinitionChanged = currentState is not defined
                or (currentState != desiredState
                    and view_definition_sql(currentState) != view_definition_sql(desiredState)) %}

        {# CreateSQL for View #}
        {%- if currentState is not defined
                or currentMatType != desiredMatType
                or nsNodeVariables.curObjectNameFullPath != nsNodeVariables.desObjectNameFullPath
                or viewDefinitionChanged %}
            {{ stage('Create Fact View', true, "sql", "create") }}
            CREATE OR REPLACE VIEW {{ nsNodeVariables.desObjectNameFullPath }}
            {{ view_definition_sql(desiredState) }}

        {%- elif currentState != desiredState %}

            {# Definition unchanged: record a metadata-only change #}
            {{ alter_metadata_sql() }}

        {%- endif %}

    {%- elif desiredMatType == 'table' %}

        {# Validate the Fact's annotations (hard fail: CREATE does not fail a test stage on row count) #}
        {{ validate_fact_requirements(true) }}
        {# Validate: one partition (node or column @partitionBy), partition expiration only on a time partition, at most 4 plain cluster columns #}
        {{ validate_partition_cluster() }}

        {# Drop the current object if it was another type #}
        {{ object_drop_sql() }}

        {%- set nsConfigVariables = namespace(options = "", partitionBy = "", clusterBy = "", primaryKey = "", createTable = false) %}

        {# Initialise the variables necessary for create of table #}
        {%- set nsConfigVariables.partitionBy = get_partition_by_sql(config, columns) | trim %}
        {%- set nsConfigVariables.clusterBy = get_clusterby_sql(columns) | trim %}
        {%- set nsConfigVariables.primaryKey = get_primary_key_sql(columns) | trim %}
        {%- set nsConfigVariables.options = get_object_options_sql(config, node.description, false, columns) | trim %}

        {# BigQuery cannot alter these on an existing table: a dataset move, or a partition / cluster change recreates it #}
        {%- if currentState is defined and currentMatType == desiredMatType
                and (nsNodeVariables.currentProjectDataset != nsNodeVariables.desiredProjectDataset
                or get_partition_by_sql(currentState.config, currentState.columns) | trim != nsConfigVariables.partitionBy
                or get_clusterby_sql(currentState.columns) | trim != nsConfigVariables.clusterBy) %}
            {%- set nsConfigVariables.createTable = true %}
        {%- endif %}

        {%- if currentState is not defined or currentMatType != desiredMatType or nsConfigVariables.createTable %}

            {# Drop current table before recreating it #}
            {%- if nsConfigVariables.createTable %}
                {{ stage('Drop Current ' + currentMatType + ' - ' + currentState.node.name, true, "sql", "drop") }}
                DROP {{ drop_materialization(currentMatType) }} {{ nsNodeVariables.curObjectNameFullPath }}
                {%- set nsNodeVariables.metaDataChanged = true %}
            {%- endif %}

            {# CreateSQL for Table #}
            {{ stage('Create Fact Table', true, "sql", "create") }}
            CREATE OR REPLACE TABLE {{ nsNodeVariables.desObjectNameFullPath }}
            (
                {%- for col in columns %}
                    `{{ col.name }}` {{ col.dataType }}
                    {%- if col.defaultValue %} DEFAULT {{ col.defaultValue }} {%- endif %}
                    {%- if col.nullable == false %} NOT NULL {%- endif %}
                    {%- if col.description | trim | length > 0 %} OPTIONS(description = '{{ col.description | escape }}') {%- endif %}
                    {%- if not loop.last or nsConfigVariables.primaryKey | length > 0 -%}, {%- endif %}
                {%- endfor %}
                {%- if nsConfigVariables.primaryKey | length > 0 %}
                    {{ nsConfigVariables.primaryKey }}
                {%- endif %}
            )
            {{ nsConfigVariables.partitionBy }}
            {{ nsConfigVariables.clusterBy }}
            {{ nsConfigVariables.options }}

        {%- elif currentState is defined and currentState != desiredState and currentMatType == desiredMatType %}

            {# NOT NULL cannot be applied to an existing BigQuery table: warn only #}
            {{ alter_column_warnings_sql() }}

            {# Every alter runs on the clone (nsNodeVariables.alterObjectNameFullPath) #}
            {%- set alterSql %}

                {# Alter Column: data type, nullability, description, default (old column names) #}
                {{ alter_modify_columns_sql() }}

                {# Add Column (default set and backfilled after the add) #}
                {{ alter_add_columns_sql() }}

                {# Rename Column (matched by @id) #}
                {{ alter_rename_columns_sql() }}

                {# Delete Column #}
                {{ alter_drop_columns_sql() }}

            {%- endset %}

            {# Clone Table -> alters -> Replace Table (clone copied back over the table) -> Delete Clone #}
            {{ alter_clone_swap_sql(alterSql) }}

            {# Edit Table Options on the table: changed options, or re-applied after Replace Table (COPY drops the expiration and tags) #}
            {{ alter_table_options_sql() }}

            {# Nothing above altered the table: record a metadata-only change #}
            {{ alter_metadata_sql() }}
        {%- endif %}
    {%- endif %}

{%- elif currentState is defined and desiredState is not defined %}

    {# Node deleted: drop the current object #}
    {{ object_drop_sql() }}

{%- endif %}
